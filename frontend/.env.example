# Public frontend configuration (all VITE_* values are exposed to the browser — NEVER put secrets here)

# Base URL for Axios API requests
# Local dev (uses Vite proxy): /api
# Production (separate backend host): https://api.example.com/api
VITE_API_BASE_URL=/api

# Vite dev server proxy target (used only by `npm run dev`)
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Optional public app display title
VITE_APP_NAME=EcoWatch

# Default UI language on first visit: en | km
VITE_DEFAULT_LOCALE=en
