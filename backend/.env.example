# Application Security
SECRET_KEY=change-this-to-a-long-random-secret-key

# PostgreSQL Database Connection
# Local Docker Compose default:
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/waste_report_db
# Example Cloud PostgreSQL (Neon / Supabase / Render):
# DATABASE_URL=postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require

# File Storage Defaults (also dynamically manageable in Admin Console -> Settings)
# Supported providers: cloudinary | s3_compatible | local
STORAGE_BACKEND=cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=waste_reports
# Or supply single connection string instead of the 3 fields above:
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Optional S3-Compatible Object Storage (Sabay Cloud S3, AWS S3, Cloudflare R2, MinIO)
# S3_ENDPOINT_URL=https://s3.cloud.sabay.com
# S3_REGION=ap-southeast-1
# S3_BUCKET=community-waste-media
# S3_ACCESS_KEY_ID=your_access_key
# S3_SECRET_ACCESS_KEY=your_secret_key
# S3_PUBLIC_BASE_URL=https://cdn.example.com
# S3_FOLDER=waste_reports
